@model IEnumerable<AcxiomCRM.Models.AuditLog>
@{
    ViewData["Title"] = "Audit Logs";
    var entities = ViewBag.Entities as List<string> ?? new List<string>();
    int currentPage = ViewBag.CurrentPage;
    int totalPages = ViewBag.TotalPages;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="fw-bold mb-0"><i class="bi bi-journal-text text-primary me-2"></i>System Audit Logs</h2>
        <span class="text-muted">Immutable log of security, authentication, and CRM record changes</span>
    </div>
    <span class="badge bg-secondary fs-6">@ViewBag.TotalItems Records Logged</span>
</div>

<!-- Filters -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-body">
        <form method="get" class="row g-2">
            <div class="col-md-3">
                <input type="text" name="search" class="form-control" placeholder="Search user, action, ID..." value="@ViewBag.Search" />
            </div>
            <div class="col-md-2">
                <select name="entity" class="form-select">
                    <option value="">-- All Entities --</option>
                    @foreach (var ent in entities)
                    {
                        <option value="@ent" selected="@(ViewBag.Entity == ent)">@ent</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <input type="date" name="fromDate" class="form-control" value="@ViewBag.FromDate" placeholder="From Date" />
            </div>
            <div class="col-md-2">
                <input type="date" name="toDate" class="form-control" value="@ViewBag.ToDate" placeholder="To Date" />
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-secondary w-100">Filter</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Reset</a>
            </div>
        </form>
    </div>
</div>

<!-- Log Table -->
<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Date & Time (UTC)</th>
                        <th>User</th>
                        <th>Action</th>
                        <th>Entity</th>
                        <th>Record ID</th>
                        <th>IP Address</th>
                        <th class="text-end">Details</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td><small class="text-muted">@item.CreatedDate.ToString("yyyy-MM-dd HH:mm:ss")</small></td>
                            <td>
                                <div class="fw-semibold">@(item.UserEmail ?? "System / Anonymous")</div>
                            </td>
                            <td>
                                <span class="badge @(item.Action.Contains("Delete") ? "bg-danger" : item.Action.Contains("Create") ? "bg-success" : item.Action.Contains("Login") ? "bg-info text-dark" : "bg-primary")">
                                    @item.Action
                                </span>
                            </td>
                            <td><span class="badge bg-light text-dark border">@item.EntityName</span></td>
                            <td><code>@(item.RecordId ?? "-")</code></td>
                            <td><small class="text-muted">@(item.IpAddress ?? "-")</small></td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@item.AuditLogId" class="btn btn-outline-secondary btn-sm">
                                    <i class="bi bi-eye"></i> View
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    @if (totalPages > 1)
    {
        <div class="card-footer bg-white d-flex justify-content-between align-items-center">
            <span class="text-muted small">Page @currentPage of @totalPages</span>
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(currentPage - 1)" asp-route-search="@ViewBag.Search" asp-route-entity="@ViewBag.Entity" asp-route-fromDate="@ViewBag.FromDate" asp-route-toDate="@ViewBag.ToDate">Previous</a>
                </li>
                @for (int p = Math.Max(1, currentPage - 2); p <= Math.Min(totalPages, currentPage + 2); p++)
                {
                    <li class="page-item @(p == currentPage ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@p" asp-route-search="@ViewBag.Search" asp-route-entity="@ViewBag.Entity" asp-route-fromDate="@ViewBag.FromDate" asp-route-toDate="@ViewBag.ToDate">@p</a>
                    </li>
                }
                <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(currentPage + 1)" asp-route-search="@ViewBag.Search" asp-route-entity="@ViewBag.Entity" asp-route-fromDate="@ViewBag.FromDate" asp-route-toDate="@ViewBag.ToDate">Next</a>
                </li>
            </ul>
        </div>
    }
</div>
