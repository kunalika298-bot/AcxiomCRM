@model AcxiomCRM.Models.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Log in";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-5">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-primary text-white text-center py-3">
                <h4 class="mb-0 fw-bold"><i class="bi bi-person-lock me-2"></i>AcxiomCRM Login</h4>
                <small class="text-white-50">Enterprise Relationship Management</small>
            </div>
            <div class="card-body p-4">
                <form asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-semibold"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                            <input asp-for="Email" class="form-control" placeholder="name@company.com" id="loginEmail" />
                        </div>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label fw-semibold"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-key"></i></span>
                            <input asp-for="Password" class="form-control" placeholder="••••••••" id="loginPassword" />
                        </div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="mb-3 form-check">
                        <input asp-for="RememberMe" class="form-check-input" />
                        <label asp-for="RememberMe" class="form-check-label"></label>
                    </div>

                    <div class="d-grid mb-3">
                        <button type="submit" class="btn btn-primary btn-lg fw-semibold">Sign In</button>
                    </div>

                    <div class="text-center">
                        <span class="text-muted">Don't have an account?</span>
                        <a asp-action="Register" class="text-decoration-none fw-semibold">Register here</a>
                    </div>
                </form>
            </div>
            <div class="card-footer bg-light p-3">
                <div class="small text-muted mb-2 fw-semibold text-center">Quick Demo Credentials:</div>
                <div class="d-flex justify-content-around">
                    <button type="button" class="btn btn-outline-danger btn-sm" onclick="setCreds('admin@acxiomcrm.com', 'Admin@123456')">Admin</button>
                    <button type="button" class="btn btn-outline-warning btn-sm text-dark" onclick="setCreds('manager@acxiomcrm.com', 'Manager@123456')">Manager</button>
                    <button type="button" class="btn btn-outline-primary btn-sm" onclick="setCreds('sales@acxiomcrm.com', 'Sales@123456')">Sales Exec</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function setCreds(email, pass) {
            document.getElementById('loginEmail').value = email;
            document.getElementById('loginPassword').value = pass;
        }
    </script>
}
