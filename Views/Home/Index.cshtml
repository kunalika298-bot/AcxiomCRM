@{
    ViewData["Title"] = "Welcome";
}

<div class="p-5 mb-4 bg-white rounded-3 shadow-sm border">
    <div class="container-fluid py-4">
        <div class="d-flex align-items-center mb-3">
            <i class="bi bi-diagram-3-fill text-primary display-4 me-3"></i>
            <div>
                <h1 class="display-5 fw-bold text-dark mb-0">AcxiomCRM</h1>
                <p class="text-muted fs-5 mb-0">Enterprise Customer Relationship Management Platform</p>
            </div>
        </div>
        <p class="col-md-9 fs-5 text-secondary">
            Streamline leads, customer lifecycles, weighted sales pipelines, follow-ups, and operational activities with role-based security, comprehensive audit logs, and REST API support.
        </p>
        <div class="mt-4">
            <a asp-controller="Account" asp-action="Login" class="btn btn-primary btn-lg px-4 me-2">
                <i class="bi bi-box-arrow-in-right me-1"></i> Sign In to CRM
            </a>
            <a asp-controller="Account" asp-action="Register" class="btn btn-outline-secondary btn-lg px-4">
                <i class="bi bi-person-plus me-1"></i> Register New User
            </a>
        </div>
    </div>
</div>

<div class="row g-4 py-2">
    <div class="col-md-4">
        <div class="card h-100 shadow-sm border-0">
            <div class="card-body">
                <div class="fs-1 text-primary mb-2"><i class="bi bi-shield-lock"></i></div>
                <h5 class="card-title fw-bold">Role-Based Security</h5>
                <p class="card-text text-muted">Strict server-side authorization partitioned for <strong>Admin</strong>, <strong>Manager</strong>, and <strong>Sales Executive</strong> roles with lockout prevention and anti-forgery tokens.</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100 shadow-sm border-0">
            <div class="card-body">
                <div class="fs-1 text-success mb-2"><i class="bi bi-funnel"></i></div>
                <h5 class="card-title fw-bold">Full CRM Workflow</h5>
                <p class="card-text text-muted">End-to-end customer and lead tracking with one-click conversion, status workflows, probability-weighted pipeline calculation, and follow-up scheduling.</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100 shadow-sm border-0">
            <div class="card-body">
                <div class="fs-1 text-info mb-2"><i class="bi bi-activity"></i></div>
                <h5 class="card-title fw-bold">Analytics & REST API</h5>
                <p class="card-text text-muted">Real-time Chart.js interactive charts, KPI metrics cards, comprehensive reporting with CSV exports, and secured REST API endpoints.</p>
            </div>
        </div>
    </div>
</div>
