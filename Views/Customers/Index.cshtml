@model IEnumerable<AcxiomCRM.Models.Customer>
@{
    ViewData["Title"] = "Customer Management";
    int currentPage = ViewBag.CurrentPage;
    int totalPages = ViewBag.TotalPages;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="fw-bold mb-0"><i class="bi bi-people text-primary me-2"></i>Customers</h2>
        <span class="text-muted">Manage accounts, contacts, and relationship records</span>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-person-plus-fill me-1"></i> New Customer
    </a>
</div>

<!-- Search & Filters -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-body">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-4">
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-search"></i></span>
                    <input type="text" name="search" class="form-control" placeholder="Search name, email, phone, company..." value="@ViewBag.Search" />
                </div>
            </div>
            <div class="col-md-2">
                <select name="status" class="form-select">
                    <option value="">-- All Statuses --</option>
                    <option value="Active" selected="@(ViewBag.Status == "Active")">Active</option>
                    <option value="Inactive" selected="@(ViewBag.Status == "Inactive")">Inactive</option>
                    <option value="LeadConverted" selected="@(ViewBag.Status == "LeadConverted")">Lead Converted</option>
                </select>
            </div>
            @if (!User.IsInRole("Sales Executive"))
            {
                <div class="col-md-3">
                    <select name="assignedTo" asp-items="ViewBag.UsersList" class="form-select">
                        <option value="">-- All Assigned Users --</option>
                    </select>
                </div>
            }
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-secondary w-100">Filter</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Reset</a>
            </div>
        </form>
    </div>
</div>

<!-- Table -->
<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Code</th>
                        <th>
                            <a asp-action="Index" asp-route-sortOrder="@(ViewBag.SortOrder == "name_desc" ? "" : "name_desc")" class="text-decoration-none text-dark">
                                Customer Name <i class="bi bi-arrow-down-up small"></i>
                            </a>
                        </th>
                        <th>Email / Phone</th>
                        <th>
                            <a asp-action="Index" asp-route-sortOrder="@(ViewBag.SortOrder == "company_asc" ? "company_desc" : "company_asc")" class="text-decoration-none text-dark">
                                Company <i class="bi bi-arrow-down-up small"></i>
                            </a>
                        </th>
                        <th>Status</th>
                        <th>Assigned To</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">
                                <i class="bi bi-inbox fs-2 d-block mb-2"></i> No customers found matching criteria.
                            </td>
                        </tr>
                    }
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td><code>@item.CustomerCode</code></td>
                            <td>
                                <div class="fw-bold">@item.CustomerName</div>
                                <small class="text-muted">@item.City, @item.State</small>
                            </td>
                            <td>
                                <div><i class="bi bi-envelope small text-muted"></i> @item.Email</div>
                                <small><i class="bi bi-telephone small text-muted"></i> @item.Phone</small>
                            </td>
                            <td>@(item.CompanyName ?? "-")</td>
                            <td>
                                <span class="badge @(item.Status == "Active" ? "bg-success" : item.Status == "Inactive" ? "bg-secondary" : "bg-info text-dark")">
                                    @item.Status
                                </span>
                            </td>
                            <td>
                                @if (item.AssignedUser != null)
                                {
                                    <span class="badge bg-light text-dark border">
                                        <i class="bi bi-person"></i> @item.AssignedUser.FullName
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted small">Unassigned</span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Details" asp-route-id="@item.CustomerId" class="btn btn-outline-secondary" title="View Details">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@item.CustomerId" class="btn btn-outline-primary" title="Edit Customer">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                                    {
                                        <a asp-action="Delete" asp-route-id="@item.CustomerId" class="btn btn-outline-danger" title="Delete Customer">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    @if (totalPages > 1)
    {
        <div class="card-footer bg-white d-flex justify-content-between align-items-center">
            <span class="text-muted small">Showing page @currentPage of @totalPages (@ViewBag.TotalItems total)</span>
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(currentPage - 1)" asp-route-search="@ViewBag.Search" asp-route-status="@ViewBag.Status" asp-route-assignedTo="@ViewBag.AssignedTo" asp-route-sortOrder="@ViewBag.SortOrder">Previous</a>
                </li>
                @for (int p = 1; p <= totalPages; p++)
                {
                    <li class="page-item @(p == currentPage ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@p" asp-route-search="@ViewBag.Search" asp-route-status="@ViewBag.Status" asp-route-assignedTo="@ViewBag.AssignedTo" asp-route-sortOrder="@ViewBag.SortOrder">@p</a>
                    </li>
                }
                <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(currentPage + 1)" asp-route-search="@ViewBag.Search" asp-route-status="@ViewBag.Status" asp-route-assignedTo="@ViewBag.AssignedTo" asp-route-sortOrder="@ViewBag.SortOrder">Next</a>
                </li>
            </ul>
        </div>
    }
</div>
