@model AcxiomCRM.Models.Customer
@{
    ViewData["Title"] = "Customer Profile";
}

<div class="row">
    <div class="col-md-4 mb-4">
        <div class="card shadow-sm border-0">
            <div class="card-body text-center p-4">
                <div class="avatar bg-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 70px; height: 70px; font-size: 1.8rem;">
                    @Model.CustomerName.Substring(0, Math.Min(2, Model.CustomerName.Length)).ToUpper()
                </div>
                <h4 class="fw-bold mb-1">@Model.CustomerName</h4>
                <div class="text-muted mb-2">@(Model.CompanyName ?? "Individual Client")</div>
                <span class="badge @(Model.Status == "Active" ? "bg-success" : "bg-secondary") mb-3">@Model.Status</span>

                <hr />

                <div class="text-start">
                    <p class="mb-2"><i class="bi bi-tag text-muted me-2"></i><strong>Code:</strong> <code>@Model.CustomerCode</code></p>
                    <p class="mb-2"><i class="bi bi-envelope text-muted me-2"></i><strong>Email:</strong> @Model.Email</p>
                    <p class="mb-2"><i class="bi bi-telephone text-muted me-2"></i><strong>Phone:</strong> @Model.Phone</p>
                    <p class="mb-2"><i class="bi bi-geo-alt text-muted me-2"></i><strong>Location:</strong> @Model.Address, @Model.City, @Model.State</p>
                    <p class="mb-2"><i class="bi bi-person-badge text-muted me-2"></i><strong>Assigned To:</strong> @(Model.AssignedUser?.FullName ?? "Unassigned")</p>
                    <p class="mb-0"><i class="bi bi-calendar text-muted me-2"></i><strong>Created:</strong> @Model.CreatedDate.ToString("yyyy-MM-dd")</p>
                </div>

                <div class="d-flex gap-2 justify-content-center mt-4">
                    <a asp-action="Edit" asp-route-id="@Model.CustomerId" class="btn btn-outline-primary btn-sm">
                        <i class="bi bi-pencil me-1"></i> Edit
                    </a>
                    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                        <i class="bi bi-arrow-left me-1"></i> Back
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-8">
        <!-- Related Opportunities -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <h6 class="mb-0 fw-bold"><i class="bi bi-cash-coin text-success me-2"></i>Associated Opportunities (@Model.Opportunities.Count)</h6>
                <a asp-controller="Opportunities" asp-action="Create" class="btn btn-sm btn-outline-success">Add Opportunity</a>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-sm table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Opportunity</th>
                                <th>Amount</th>
                                <th>Stage</th>
                                <th>Probability</th>
                                <th>Weighted ($)</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.Opportunities.Any())
                            {
                                <tr><td colspan="5" class="text-center text-muted py-3">No opportunities yet.</td></tr>
                            }
                            @foreach (var opp in Model.Opportunities)
                            {
                                <tr>
                                    <td><a asp-controller="Opportunities" asp-action="Details" asp-route-id="@opp.OpportunityId" class="fw-semibold text-decoration-none">@opp.OpportunityName</a></td>
                                    <td>$@opp.Amount.ToString("N2")</td>
                                    <td><span class="badge bg-info text-dark">@opp.Stage</span></td>
                                    <td>@opp.Probability%</td>
                                    <td><strong>$@opp.WeightedPipeline.ToString("N2")</strong></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Related Follow-Ups -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <h6 class="mb-0 fw-bold"><i class="bi bi-calendar-check text-primary me-2"></i>Follow-Ups (@Model.FollowUps.Count)</h6>
                <a asp-controller="FollowUps" asp-action="Create" class="btn btn-sm btn-outline-primary">Add Follow-Up</a>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-sm table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Date</th>
                                <th>Type</th>
                                <th>Status</th>
                                <th>Remarks</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.FollowUps.Any())
                            {
                                <tr><td colspan="4" class="text-center text-muted py-3">No follow-ups recorded.</td></tr>
                            }
                            @foreach (var fu in Model.FollowUps)
                            {
                                <tr>
                                    <td>@fu.FollowUpDate.ToString("yyyy-MM-dd HH:mm")</td>
                                    <td>@fu.FollowUpType</td>
                                    <td><span class="badge @(fu.Status == "Completed" ? "bg-success" : fu.Status == "Missed" ? "bg-danger" : "bg-warning text-dark")">@fu.Status</span></td>
                                    <td>@(fu.Remarks ?? "-")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
