@model IEnumerable<AcxiomCRM.Models.Opportunity>
@{
    ViewData["Title"] = "Opportunities & Pipeline";
    int currentPage = ViewBag.CurrentPage;
    int totalPages = ViewBag.TotalPages;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="fw-bold mb-0"><i class="bi bi-cash-coin text-success me-2"></i>Opportunities & Pipeline</h2>
        <span class="text-muted">Track revenue potential, stage progressions, and weighted forecast</span>
    </div>
    <a asp-action="Create" class="btn btn-success">
        <i class="bi bi-plus-circle me-1"></i> New Opportunity
    </a>
</div>

<!-- Pipeline Highlights Banner -->
<div class="row g-3 mb-4">
    <div class="col-md-6">
        <div class="card bg-white shadow-sm border-0 border-start border-primary border-4 p-3">
            <span class="text-muted small text-uppercase fw-bold">Total Filtered Pipeline</span>
            <h3 class="fw-bold text-primary mb-0">$@ViewBag.TotalValue.ToString("N2")</h3>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card bg-white shadow-sm border-0 border-start border-success border-4 p-3">
            <span class="text-muted small text-uppercase fw-bold">Weighted Pipeline Value</span>
            <h3 class="fw-bold text-success mb-0">$@ViewBag.WeightedValue.ToString("N2")</h3>
        </div>
    </div>
</div>

<!-- Filters -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-body">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-3">
                <input type="text" name="search" class="form-control" placeholder="Search opportunity, client..." value="@ViewBag.Search" />
            </div>
            <div class="col-md-2">
                <select name="stage" class="form-select">
                    <option value="">-- All Stages --</option>
                    <option value="Qualification" selected="@(ViewBag.Stage == "Qualification")">Qualification</option>
                    <option value="Proposal" selected="@(ViewBag.Stage == "Proposal")">Proposal</option>
                    <option value="Negotiation" selected="@(ViewBag.Stage == "Negotiation")">Negotiation</option>
                    <option value="Won" selected="@(ViewBag.Stage == "Won")">Won</option>
                    <option value="Lost" selected="@(ViewBag.Stage == "Lost")">Lost</option>
                </select>
            </div>
            <div class="col-md-2">
                <select name="status" class="form-select">
                    <option value="">-- All Statuses --</option>
                    <option value="Open" selected="@(ViewBag.Status == "Open")">Open</option>
                    <option value="Won" selected="@(ViewBag.Status == "Won")">Won</option>
                    <option value="Lost" selected="@(ViewBag.Status == "Lost")">Lost</option>
                </select>
            </div>
            @if (!User.IsInRole("Sales Executive"))
            {
                <div class="col-md-3">
                    <select name="assignedTo" asp-items="ViewBag.UsersList" class="form-select">
                        <option value="">-- All Owners --</option>
                    </select>
                </div>
            }
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-secondary w-100">Filter</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Reset</a>
            </div>
        </form>
    </div>
</div>

<!-- Table -->
<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Opportunity Name</th>
                        <th>Account / Lead</th>
                        <th>Amount</th>
                        <th>Stage</th>
                        <th>Probability</th>
                        <th>Weighted Value</th>
                        <th>Close Date</th>
                        <th>Owner</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="9" class="text-center py-4 text-muted">No opportunities found matching criteria.</td>
                        </tr>
                    }
                    @foreach (var opp in Model)
                    {
                        <tr>
                            <td>
                                <a asp-action="Details" asp-route-id="@opp.OpportunityId" class="fw-bold text-decoration-none text-dark">
                                    @opp.OpportunityName
                                </a>
                            </td>
                            <td>
                                @if (opp.Customer != null)
                                {
                                    <span class="badge bg-light text-dark border"><i class="bi bi-building"></i> @opp.Customer.CustomerName</span>
                                }
                                else if (opp.Lead != null)
                                {
                                    <span class="badge bg-light text-dark border"><i class="bi bi-funnel"></i> @opp.Lead.LeadName</span>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                            <td><strong>$@opp.Amount.ToString("N2")</strong></td>
                            <td>
                                <span class="badge @(opp.Stage == "Won" ? "bg-success" : opp.Stage == "Lost" ? "bg-danger" : opp.Stage == "Negotiation" ? "bg-warning text-dark" : "bg-primary")">
                                    @opp.Stage
                                </span>
                            </td>
                            <td>@opp.Probability%</td>
                            <td><strong class="text-success">$@opp.WeightedPipeline.ToString("N2")</strong></td>
                            <td><small class="text-muted">@opp.ExpectedCloseDate.ToString("yyyy-MM-dd")</small></td>
                            <td><small class="fw-semibold">@(opp.AssignedUser?.FullName ?? "Unassigned")</small></td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Details" asp-route-id="@opp.OpportunityId" class="btn btn-outline-secondary"><i class="bi bi-eye"></i></a>
                                    <a asp-action="Edit" asp-route-id="@opp.OpportunityId" class="btn btn-outline-primary"><i class="bi bi-pencil"></i></a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    @if (totalPages > 1)
    {
        <div class="card-footer bg-white d-flex justify-content-between align-items-center">
            <span class="text-muted small">Page @currentPage of @totalPages</span>
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(currentPage - 1)">Previous</a>
                </li>
                @for (int p = 1; p <= totalPages; p++)
                {
                    <li class="page-item @(p == currentPage ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@p">@p</a>
                    </li>
                }
                <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(currentPage + 1)">Next</a>
                </li>
            </ul>
        </div>
    }
</div>
