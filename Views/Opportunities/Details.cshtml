@model AcxiomCRM.Models.Opportunity
@{
    ViewData["Title"] = "Opportunity Details";
}

<div class="row">
    <div class="col-md-5 mb-4">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="badge @(Model.Stage == "Won" ? "bg-success" : Model.Stage == "Lost" ? "bg-danger" : "bg-primary") fs-6">
                        @Model.Stage
                    </span>
                    <span class="text-muted small">Status: <strong>@Model.Status</strong></span>
                </div>
                <h4 class="fw-bold mb-3">@Model.OpportunityName</h4>

                <div class="row g-2 mb-3 text-center">
                    <div class="col-6">
                        <div class="p-3 bg-light rounded">
                            <small class="text-muted d-block text-uppercase fw-semibold">Amount</small>
                            <span class="fs-4 fw-bold text-dark">$@Model.Amount.ToString("N2")</span>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="p-3 bg-light rounded">
                            <small class="text-muted d-block text-uppercase fw-semibold">Weighted Value</small>
                            <span class="fs-4 fw-bold text-success">$@Model.WeightedPipeline.ToString("N2")</span>
                        </div>
                    </div>
                </div>

                <div class="mb-3">
                    <div class="d-flex justify-content-between small text-muted mb-1">
                        <span>Win Probability:</span>
                        <strong class="text-dark">@Model.Probability%</strong>
                    </div>
                    <div class="progress" style="height: 10px;">
                        <div class="progress-bar @(Model.Probability >= 70 ? "bg-success" : Model.Probability >= 40 ? "bg-warning" : "bg-danger")" style="width: @Model.Probability%"></div>
                    </div>
                </div>

                <hr />

                <div class="text-start">
                    <p class="mb-2"><i class="bi bi-calendar-event text-muted me-2"></i><strong>Expected Close:</strong> @Model.ExpectedCloseDate.ToString("yyyy-MM-dd")</p>
                    <p class="mb-2"><i class="bi bi-person text-muted me-2"></i><strong>Owner:</strong> @(Model.AssignedUser?.FullName ?? "Unassigned")</p>
                    @if (Model.Customer != null)
                    {
                        <p class="mb-2"><i class="bi bi-building text-muted me-2"></i><strong>Customer:</strong> <a asp-controller="Customers" asp-action="Details" asp-route-id="@Model.CustomerId">@Model.Customer.CustomerName</a></p>
                    }
                    @if (Model.Lead != null)
                    {
                        <p class="mb-2"><i class="bi bi-funnel text-muted me-2"></i><strong>Lead:</strong> <a asp-controller="Leads" asp-action="Details" asp-route-id="@Model.LeadId">@Model.Lead.LeadName</a></p>
                    }
                    <p class="mb-0"><i class="bi bi-tag text-muted me-2"></i><strong>Source:</strong> @(Model.Source ?? "Direct")</p>
                </div>

                <div class="d-flex gap-2 justify-content-center mt-4">
                    <a asp-action="Edit" asp-route-id="@Model.OpportunityId" class="btn btn-outline-primary btn-sm">Edit Opportunity</a>
                    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Back</a>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-7">
        @if (!string.IsNullOrEmpty(Model.Notes))
        {
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-white py-3 fw-bold">Deal Notes & Timeline</div>
                <div class="card-body text-muted" style="white-space: pre-wrap;">@Model.Notes</div>
            </div>
        }

        <!-- Related Follow-Ups -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <h6 class="mb-0 fw-bold"><i class="bi bi-calendar-check text-primary me-2"></i>Opportunity Follow-Ups (@Model.FollowUps.Count)</h6>
                <a asp-controller="FollowUps" asp-action="Create" class="btn btn-sm btn-outline-primary">Add Follow-Up</a>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-sm table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Date</th>
                                <th>Type</th>
                                <th>Status</th>
                                <th>Remarks</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.FollowUps.Any())
                            {
                                <tr><td colspan="4" class="text-center text-muted py-3">No follow-ups logged for this opportunity.</td></tr>
                            }
                            @foreach (var fu in Model.FollowUps)
                            {
                                <tr>
                                    <td>@fu.FollowUpDate.ToString("yyyy-MM-dd HH:mm")</td>
                                    <td>@fu.FollowUpType</td>
                                    <td><span class="badge @(fu.Status == "Completed" ? "bg-success" : "bg-warning text-dark")">@fu.Status</span></td>
                                    <td>@(fu.Remarks ?? "-")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
