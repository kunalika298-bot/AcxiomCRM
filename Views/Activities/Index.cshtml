@model IEnumerable<AcxiomCRM.Models.Activity>
@{
    ViewData["Title"] = "Activities";
    int currentPage = ViewBag.CurrentPage;
    int totalPages = ViewBag.TotalPages;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="fw-bold mb-0"><i class="bi bi-clock-history text-primary me-2"></i>Activity Log</h2>
        <span class="text-muted">Track calls, meetings, emails, and client interactions</span>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle me-1"></i> Log Activity
    </a>
</div>

<!-- Filters -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-body">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-3">
                <input type="text" name="search" class="form-control" placeholder="Search subject, description..." value="@ViewBag.Search" />
            </div>
            <div class="col-md-2">
                <select name="type" class="form-select">
                    <option value="">-- All Types --</option>
                    <option value="Call" selected="@(ViewBag.Type == "Call")">Call</option>
                    <option value="Meeting" selected="@(ViewBag.Type == "Meeting")">Meeting</option>
                    <option value="Email" selected="@(ViewBag.Type == "Email")">Email</option>
                    <option value="Task" selected="@(ViewBag.Type == "Task")">Task</option>
                </select>
            </div>
            <div class="col-md-2">
                <input type="date" name="date" class="form-control" value="@ViewBag.Date" />
            </div>
            @if (!User.IsInRole("Sales Executive"))
            {
                <div class="col-md-3">
                    <select name="assignedTo" asp-items="ViewBag.UsersList" class="form-select">
                        <option value="">-- All Logged By --</option>
                    </select>
                </div>
            }
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-secondary w-100">Filter</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Reset</a>
            </div>
        </form>
    </div>
</div>

<!-- Activities Table -->
<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Date & Time</th>
                        <th>Type</th>
                        <th>Subject</th>
                        <th>Client / Lead</th>
                        <th>User</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">No activities recorded.</td>
                        </tr>
                    }
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <div class="fw-bold">@item.ActivityDate.ToString("yyyy-MM-dd")</div>
                                <small class="text-muted">@item.ActivityDate.ToString("hh:mm tt")</small>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">
                                    <i class="bi bi-@(item.ActivityType == "Call" ? "telephone" : item.ActivityType == "Meeting" ? "people" : item.ActivityType == "Email" ? "envelope" : "list-check") me-1"></i>
                                    @item.ActivityType
                                </span>
                            </td>
                            <td>
                                <div class="fw-semibold">@item.Subject</div>
                                @if (!string.IsNullOrEmpty(item.Description))
                                {
                                    <small class="text-muted text-truncate d-inline-block" style="max-width: 300px;">@item.Description</small>
                                }
                            </td>
                            <td>
                                @if (item.Customer != null)
                                {
                                    <div><i class="bi bi-building text-primary small"></i> <a asp-controller="Customers" asp-action="Details" asp-route-id="@item.CustomerId" class="text-decoration-none">@item.Customer.CustomerName</a></div>
                                }
                                else if (item.Lead != null)
                                {
                                    <div><i class="bi bi-funnel text-info small"></i> <a asp-controller="Leads" asp-action="Details" asp-route-id="@item.LeadId" class="text-decoration-none">@item.Lead.LeadName</a></div>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                            <td><small class="fw-semibold">@(item.AssignedUser?.FullName ?? "Unassigned")</small></td>
                            <td>
                                <span class="badge @(item.Status == "Completed" ? "bg-success" : item.Status == "Pending" ? "bg-warning text-dark" : "bg-secondary")">
                                    @item.Status
                                </span>
                            </td>
                            <td class="text-end">
                                <a asp-action="Edit" asp-route-id="@item.ActivityId" class="btn btn-outline-secondary btn-sm">
                                    <i class="bi bi-pencil"></i> Edit
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    @if (totalPages > 1)
    {
        <div class="card-footer bg-white d-flex justify-content-between align-items-center">
            <span class="text-muted small">Page @currentPage of @totalPages</span>
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(currentPage - 1)">Previous</a>
                </li>
                @for (int p = 1; p <= totalPages; p++)
                {
                    <li class="page-item @(p == currentPage ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@p">@p</a>
                    </li>
                }
                <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(currentPage + 1)">Next</a>
                </li>
            </ul>
        </div>
    }
</div>
