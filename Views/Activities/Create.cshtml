@model AcxiomCRM.Models.Activity
@{
    ViewData["Title"] = "Log Activity";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-primary text-white py-3">
                <h5 class="mb-0 fw-bold"><i class="bi bi-clock-history me-2"></i>Log Client Activity</h5>
            </div>
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="ActivityType" class="form-label fw-semibold"></label>
                            <select asp-for="ActivityType" class="form-select">
                                <option value="Call">Call</option>
                                <option value="Meeting">Meeting</option>
                                <option value="Email">Email</option>
                                <option value="Task">Task</option>
                            </select>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="ActivityDate" class="form-label fw-semibold"></label>
                            <input asp-for="ActivityDate" class="form-control" type="datetime-local" />
                            <span asp-validation-for="ActivityDate" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Subject" class="form-label fw-semibold"></label>
                        <input asp-for="Subject" class="form-control" placeholder="Brief summary of interaction" />
                        <span asp-validation-for="Subject" class="text-danger small"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="CustomerId" class="form-label fw-semibold"></label>
                            <select asp-for="CustomerId" asp-items="ViewBag.CustomerId" class="form-select">
                                <option value="">-- None / Link to Lead --</option>
                            </select>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="LeadId" class="form-label fw-semibold"></label>
                            <select asp-for="LeadId" asp-items="ViewBag.LeadId" class="form-select">
                                <option value="">-- None / Link to Customer --</option>
                            </select>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Status" class="form-label fw-semibold"></label>
                        <select asp-for="Status" class="form-select">
                            <option value="Completed">Completed</option>
                            <option value="Pending">Pending</option>
                            <option value="Cancelled">Cancelled</option>
                        </select>
                    </div>

                    @if (!User.IsInRole("Sales Executive"))
                    {
                        <div class="mb-3">
                            <label asp-for="AssignedTo" class="form-label fw-semibold"></label>
                            <select asp-for="AssignedTo" asp-items="ViewBag.AssignedTo" class="form-select">
                                <option value="">-- Current User --</option>
                            </select>
                        </div>
                    }

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label fw-semibold"></label>
                        <textarea asp-for="Description" class="form-control" rows="3" placeholder="Key outcomes, attendee details, action items..."></textarea>
                    </div>

                    <div class="d-flex justify-content-between pt-2">
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-primary fw-semibold">Save Activity</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
