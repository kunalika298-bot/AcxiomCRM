@model AcxiomCRM.Models.Lead
@{
    ViewData["Title"] = "Lead Details";
}

<div class="row">
    <div class="col-md-4 mb-4">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4 text-center">
                <div class="avatar bg-info text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 70px; height: 70px; font-size: 1.8rem;">
                    @Model.LeadName.Substring(0, Math.Min(2, Model.LeadName.Length)).ToUpper()
                </div>
                <h4 class="fw-bold mb-1">@Model.LeadName</h4>
                <div class="text-muted mb-2">@(Model.CompanyName ?? "Individual Lead")</div>
                <div class="mb-3">
                    <span class="badge @(Model.Status == "Converted" ? "bg-success" : Model.Status == "Qualified" ? "bg-primary" : "bg-info text-dark")">@Model.Status</span>
                    <span class="badge @(Model.Priority == "High" ? "bg-danger" : "bg-warning text-dark")">@Model.Priority Priority</span>
                </div>

                <div class="p-3 bg-light rounded text-center mb-3">
                    <small class="text-muted text-uppercase fw-semibold d-block">Expected Value</small>
                    <span class="fs-4 fw-bold text-success">$@Model.ExpectedValue.ToString("N2")</span>
                </div>

                <div class="text-start">
                    <p class="mb-2"><i class="bi bi-tag text-muted me-2"></i><strong>Code:</strong> <code>@Model.LeadCode</code></p>
                    <p class="mb-2"><i class="bi bi-envelope text-muted me-2"></i><strong>Email:</strong> @Model.Email</p>
                    <p class="mb-2"><i class="bi bi-telephone text-muted me-2"></i><strong>Phone:</strong> @Model.Phone</p>
                    <p class="mb-2"><i class="bi bi-funnel text-muted me-2"></i><strong>Source:</strong> @(Model.Source ?? "Direct")</p>
                    <p class="mb-2"><i class="bi bi-person text-muted me-2"></i><strong>Assigned:</strong> @(Model.AssignedUser?.FullName ?? "Unassigned")</p>
                    <p class="mb-0"><i class="bi bi-calendar text-muted me-2"></i><strong>Created:</strong> @Model.CreatedDate.ToString("yyyy-MM-dd")</p>
                </div>

                @if (Model.ConvertedCustomer != null)
                {
                    <div class="alert alert-success mt-3 text-start small">
                        <i class="bi bi-check-circle-fill me-1"></i> Converted to Customer:
                        <a asp-controller="Customers" asp-action="Details" asp-route-id="@Model.ConvertedCustomer.CustomerId" class="fw-bold text-success text-decoration-none d-block">
                            @Model.ConvertedCustomer.CustomerName
                        </a>
                    </div>
                }

                <div class="d-flex gap-2 justify-content-center mt-4">
                    <a asp-action="Edit" asp-route-id="@Model.LeadId" class="btn btn-outline-primary btn-sm">Edit</a>
                    @if (Model.Status != "Converted")
                    {
                        <a asp-action="Convert" asp-route-id="@Model.LeadId" class="btn btn-success btn-sm">Convert to Customer</a>
                    }
                    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Back</a>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-8">
        <!-- Quick Status Workflow Bar -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-body p-3">
                <div class="d-flex justify-content-between align-items-center">
                    <span class="fw-bold text-muted small text-uppercase">Workflow Stage:</span>
                    <div class="btn-group btn-group-sm">
                        @foreach (var st in new[] { "New", "Contacted", "Qualified", "Unqualified", "Lost" })
                        {
                            <form asp-action="UpdateStatus" asp-route-id="@Model.LeadId" asp-route-status="@st" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn @(Model.Status == st ? "btn-primary" : "btn-outline-secondary") btn-sm @(Model.Status == "Converted" ? "disabled" : "")">
                                    @st
                                </button>
                            </form>
                        }
                    </div>
                </div>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(Model.Notes))
        {
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-white py-3 fw-bold">Discovery & Opportunity Notes</div>
                <div class="card-body text-muted" style="white-space: pre-wrap;">@Model.Notes</div>
            </div>
        }

        <!-- Related Follow-Ups -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <h6 class="mb-0 fw-bold"><i class="bi bi-calendar-check text-primary me-2"></i>Scheduled Follow-Ups (@Model.FollowUps.Count)</h6>
                <a asp-controller="FollowUps" asp-action="Create" class="btn btn-sm btn-outline-primary">Add Follow-Up</a>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-sm table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Date</th>
                                <th>Type</th>
                                <th>Status</th>
                                <th>Remarks</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.FollowUps.Any())
                            {
                                <tr><td colspan="4" class="text-center text-muted py-3">No follow-ups scheduled for this lead.</td></tr>
                            }
                            @foreach (var fu in Model.FollowUps)
                            {
                                <tr>
                                    <td>@fu.FollowUpDate.ToString("yyyy-MM-dd HH:mm")</td>
                                    <td>@fu.FollowUpType</td>
                                    <td><span class="badge @(fu.Status == "Completed" ? "bg-success" : fu.Status == "Missed" ? "bg-danger" : "bg-warning text-dark")">@fu.Status</span></td>
                                    <td>@(fu.Remarks ?? "-")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
